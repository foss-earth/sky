{
  "name": "@foss-earth/sky",
  "version": "0.1.0",
  "private": true,
  "description": "Clear atmosphere, astronomy, photometry and injected sky/clock integration.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./settings": {
      "source": "./src/settings.ts",
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./panels": {
      "source": "./src/panels/index.ts",
      "types": "./dist/panels/index.d.ts",
      "import": "./dist/panels/index.js"
    },
    "./babylon": {
      "source": "./src/babylon/index.ts",
      "types": "./dist/babylon/index.d.ts",
      "import": "./dist/babylon/index.js"
    },
    "./styles.css": {
      "source": "./src/styles/sky.css",
      "default": "./dist/styles/sky.css"
    },
    "./catalogue": {
      "source": "./src/catalogue.ts",
      "types": "./dist/catalogue.d.ts",
      "import": "./dist/catalogue.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "fixtures",
    "scripts/sky",
    "scripts/outputDirectory.mjs",
    "scripts/validation",
    "scripts/lib",
    "docs",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run --maxWorkers=50%",
    "test:consumer": "node scripts/check-installed-artifact.mjs",
    "typecheck:consumer": "tsc -p fixtures/consumer/tsconfig.json",
    "ci": "npm run check:implementation",
    "generate:stars": "node scripts/sky/build-star-catalogue.mjs",
    "generate:solar-terms": "node scripts/sky/extract-spa-terms.mjs",
    "generate:atmosphere-tables": "node scripts/sky/build-atmosphere-tables.mjs",
    "check:implementation": "npm run typecheck && npm run lint && npm test && npm run build && npm run typecheck:consumer && npm run typecheck:validation",
    "typecheck:validation": "tsc -p scripts/validation/tsconfig.json --noEmit --tsBuildInfoFile node_modules/.tmp/sky-validation.tsbuildinfo",
    "validate:model": "node scripts/validation/sky-model.mjs",
    "validate:render": "node scripts/validation/sky-render.mjs"
  },
  "peerDependencies": {
    "@foss-earth/ui": "0.1.0",
    "@babylonjs/core": "8.56.2"
  },
  "peerDependenciesMeta": {
    "@foss-earth/ui": {
      "optional": true
    },
    "@babylonjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.6",
    "@foss-earth/engine": "0.1.0",
    "@foss-earth/renderer": "0.1.0",
    "@types/node": "24.12.4",
    "vite": "8.3.4",
    "@foss-earth/research": "0.1.0",
    "@foss-earth/ui": "0.1.0",
    "@babylonjs/core": "8.56.2"
  }
}
